# Local dev doesn't need this file at all — it just falls back to reading
# .env for config and data/standard_members.csv for the roster (see
# .env.example / README for that local setup).
#
# For a Streamlit Community Cloud deployment, paste something shaped like
# this into your app's Settings -> Secrets in the Streamlit Cloud dashboard
# (not into a file in the repo — that dashboard is the only place this
# content should ever live).
#
# Top-level keys (everything above the [data] section) are auto-injected by
# Streamlit Cloud as real environment variables too, which is what lets the
# existing os.getenv(...) calls in core/gemini_client.py pick them up with no
# code changes. Keys nested under a [section], like standard_members_csv
# below, are only reachable via st.secrets — which is exactly why the roster
# CSV lives under [data] rather than at the top level.

GEMINI_API_KEY = "your_key_here"

# Optional overrides — omit either line to use the code defaults. Google's
# model lineup changes over time; check https://ai.google.dev/gemini-api/docs/models
# for the current one if a default in the code goes stale.
GEMINI_VISION_MODEL = "gemini-2.5-flash"
GEMINI_TEXT_MODEL = "gemini-2.5-flash"

[data]
standard_members_csv = """
name
Jane Example
John Sample
Ada Placeholder
"""

# Google Sheets integration (roster + "Post attendance to Google Sheets").
# GOOGLE_SHEET_ID is a top-level key (like GEMINI_API_KEY above) so it's
# auto-injected into os.environ too. Without both this and
# [gcp_service_account] set, the app falls back to standard_members_csv
# above for the roster, and Step 5 shows as unavailable.
GOOGLE_SHEET_ID = "your_spreadsheet_id_here"

# Streamlit's own documented convention for a Google service account
# (https://docs.streamlit.io/develop/tutorials/databases/private-gsheet) —
# paste the full contents of your downloaded service-account JSON key here.
# Share the spreadsheet above with this key's client_email as Editor.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
