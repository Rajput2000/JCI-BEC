GEMINI_API_KEY=your_key_here
# Get one at https://aistudio.google.com/apikey

# Optional overrides — Google's model lineup changes over time, so these
# default in code but can be swapped here without touching any source file.
# Check https://ai.google.dev/gemini-api/docs/models for the current lineup.
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120

# Optional fallback: when a Gemini call fails, the same request goes to
# OpenRouter. Get a key at https://openrouter.ai/keys and turn off "allow
# training on prompts" in its privacy settings. Leave unset to disable.
OPENROUTER_API_KEY=
# Comma-separated, tried in order. Free models: https://openrouter.ai/models?q=free
OPENROUTER_MODELS=dots-studio/dots-3-note-preview:free
OPENROUTER_TIMEOUT_SECONDS=240

# Optional override for the CSV fallback used when Google Sheets isn't
# configured below (or is unreachable).
STANDARD_MEMBERS_CSV_PATH=data/standard_members.csv

# Google Sheets integration (roster + "Post attendance to Google Sheets").
# Both required to enable it — without them the app falls back to the CSV
# above for the roster, and Step 5 shows as unavailable.
# The spreadsheet ID is the long id in its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here
# Local dev only: path to a service-account JSON key file (Google Cloud
# Console -> IAM & Admin -> Service Accounts -> Keys -> Create new key),
# with that service account shared as Editor on the spreadsheet above.
# Gitignored — never commit it. On Streamlit Cloud, use the
# [gcp_service_account] block in secrets.toml instead (see
# .streamlit/secrets.toml.example).
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=service_account.json
