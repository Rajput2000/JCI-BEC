GROQ_API_KEY=your_key_here

# Optional overrides — Groq's model lineup changes over time, so these
# default in code but can be swapped here without touching any source file.
# Check https://console.groq.com/docs/models for the current lineup.
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Optional override for where the standard member list is read from.
STANDARD_MEMBERS_CSV_PATH=data/standard_members.csv
